{
  "name": "nekotype",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @nekotype/web run dev",
    "build": "pnpm -r --if-present run build",
    "preview": "pnpm --filter @nekotype/web run preview",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "fonts": "pnpm --filter @nekotype/web run fonts",
    "budget": "pnpm -r --if-present run budget",
    "e2e": "pnpm -r --if-present run e2e",
    "e2e:latency": "pnpm -r --if-present run e2e:latency",
    "verify:quick": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build && pnpm run budget",
    "verify": "pnpm run verify:quick && pnpm run e2e",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "private": true
}
